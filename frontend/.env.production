# Docker nginx 프록시 환경 (http://localhost:3000)
# /api/ 요청을 nginx가 backend:8080으로 프록시 → 상대경로 그대로 사용
VITE_API_BASE_URL=/api

# 태블릿 키오스크가 접속할 주소. 비워두면 접수 화면의 현재 origin을 사용한다.
# 접수 화면의 "키오스크 QR" 카드에서 재빌드 없이 덮어쓸 수 있다(localStorage 우선).
#   Wi-Fi LAN        예) http://192.168.0.12:3000
#   adb reverse(USB) 예) http://localhost:3000
VITE_KIOSK_BASE_URL=
