# 로컬 Vite dev 환경 (http://localhost:5173)
# vite.config.ts의 server.proxy가 /api → localhost:8080 으로 처리
VITE_API_BASE_URL=/api

# 태블릿 키오스크가 접속할 주소. 비워두면 접수 화면의 현재 origin을 사용한다.
# 접수 화면의 "키오스크 QR" 카드에서 재빌드 없이 덮어쓸 수 있다(localStorage 우선).
#   Wi-Fi LAN        예) http://192.168.0.12:5173
#   adb reverse(USB) 예) http://localhost:5173
VITE_KIOSK_BASE_URL=
