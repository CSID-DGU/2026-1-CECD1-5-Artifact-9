# =============================================
# Team Artifact — 환경변수 템플릿
# =============================================
# 사용법:
#   cp .env.example .env
#   그리고 아래 "필수" 항목을 채운다.
#
# .env 는 .gitignore 에 있으므로 절대 커밋되지 않는다.
# 이 파일(.env.example)에는 실제 값을 절대 적지 않는다.
# =============================================


# ---------------------------------------------
# [필수] JWT 서명키
# ---------------------------------------------
# 이 값을 아는 사람은 누구나 로그인 없이 토큰을 위조할 수 있다.
# 따라서 기본값이 없고, 비어 있으면 서버가 기동되지 않는다.
#
# 생성:  openssl rand -base64 48
JWT_SECRET=

# 토큰 만료 시간(ms). 생략하면 24시간.
# JWT_EXPIRATION_MS=86400000


# ---------------------------------------------
# [필수] 백엔드 ↔ FastAPI 내부 호출 시크릿
# ---------------------------------------------
# FastAPI 에는 로그인이 없다. 이 값을 헤더로 주고받아 "백엔드가 부른 것"임을 확인한다.
# 비어 있으면 FastAPI 가 기동되지 않는다 (무방비로 뜨는 것보다 안 뜨는 편이 안전하다).
#
# 생성:  openssl rand -base64 32
INTERNAL_API_SECRET=


# ---------------------------------------------
# [필수] MySQL
# ---------------------------------------------
# 비어 있으면 컨테이너가 뜨지 않는다. 예전에는 비워두면 rootpass 로 넘어갔는데,
# 그 값이 공개 저장소에 적혀 있어 사실상 비밀번호가 없는 것과 같았다.
#
# 생성:  openssl rand -base64 24
DB_PASSWORD=
# 도커로 실행할 때는 아래 두 줄이 필요 없다 (docker-compose.yml 에서 주입).
# 로컬에서 백엔드만 따로 띄울 때만 사용한다.
# DB_URL=jdbc:mysql://localhost:3306/artifact_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
# DB_USERNAME=root


# ---------------------------------------------
# [선택] 초기 관리자 계정
# ---------------------------------------------
# 둘 다 채우면 서버 기동 시 ADMIN 계정을 1회 생성한다.
# 비워두면 만들지 않는다 — 이 경우 화면에서 회원가입해 사용하면 된다.
# (회원가입으로는 DOCTOR/NURSE/STAFF 만 만들 수 있고 ADMIN 은 만들 수 없다)
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=


# ---------------------------------------------
# [선택] 이미지 저장소
# ---------------------------------------------
# local = 서버 디스크에 저장 (AWS 없이 개발 가능)
# s3    = AWS S3 사용
IMAGE_STORAGE_TYPE=local
IMAGE_LOCAL_UPLOAD_DIR=/tmp/artifact-images

# IMAGE_STORAGE_TYPE=s3 일 때만 필요
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1


# ---------------------------------------------
# [선택] AI 추론 서버
# ---------------------------------------------
# FASTAPI_URL=http://localhost:8000
# MIN_TOP1_CONFIDENCE=0.45


# ---------------------------------------------
# [선택] 배포 도메인 (CORS)
# ---------------------------------------------
# 브라우저는 주소창과 같은 출처라도 POST 에 Origin 헤더를 붙이고, Caddy·nginx 가 이를 그대로
# 백엔드에 넘긴다. 그래서 접속 도메인이 허용 목록에 없으면 로그인부터 실패한다
# ("Invalid CORS request"). 로컬 개발 출처는 코드에 이미 들어 있어 신경 쓸 필요 없다.
#
# 비워두면 docker-compose.yml 의 기본값(https://artifact-prod.duckdns.org)을 쓴다.
# 도메인을 바꿨다면 여기에 새 주소를 적는다. 여러 개면 쉼표로 나열.
# CORS_ALLOWED_ORIGINS=https://artifact-prod.duckdns.org


# ---------------------------------------------
# [선택] Gemini (처방 코멘트)
# ---------------------------------------------
# 비워두면 코멘트 API 가 "키가 설정되지 않았습니다"를 반환한다. 앱은 정상 동작.
GEMINI_API_KEY=
# 사용할 모델. 비워두면 gemini-3.1-flash-lite.
# GEMINI_MODEL=


# ---------------------------------------------
# [선택] 의료기관 정보 (제증명 문서 머리말)
# ---------------------------------------------
# 진단서·처방전 등 법정서식에 기재되는 값. 비워두면 문서의 해당 칸이 빈 채로 출력된다.
HOSPITAL_NAME=아티팩트 피부과의원
HOSPITAL_ADDRESS=서울특별시 중구 필동 
HOSPITAL_PHONE=02-1234-1234
# 요양기관번호 (건강보험 청구용 8자리)
HOSPITAL_REGISTRATION_NO=
# 직인 이미지. 비워두면 docker-compose.yml 의 기본값 /hospital-seal.svg 를 쓴다
# (frontend/public/hospital-seal.svg 파일이 그 주소로 서빙된다).
# 도장을 바꾸려면 그 파일을 교체하는 편이 낫고, 외부 주소를 쓰려면 여기에 https:// 주소를 적는다.
# 도커 없이 백엔드만 로컬로 띄울 때는 값이 비어 '(직인생략)' 이 되므로, 확인하려면 여기에 적는다.
# HOSPITAL_SEAL_IMAGE_URL=/hospital-seal.svg
