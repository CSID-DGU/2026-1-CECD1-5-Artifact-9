# =============================================
# Team Artifact — 환경변수 템플릿
# =============================================
# 사용법:
#   cp .env.example .env
#   그리고 아래 "필수" 항목을 채운다.
#
# .env 는 .gitignore 에 있으므로 절대 커밋되지 않는다.
# 이 파일(.env.example)에는 실제 값을 절대 적지 않는다.
# =============================================


# ---------------------------------------------
# [필수] JWT 서명키
# ---------------------------------------------
# 이 값을 아는 사람은 누구나 로그인 없이 토큰을 위조할 수 있다.
# 따라서 기본값이 없고, 비어 있으면 서버가 기동되지 않는다.
#
# 생성:  openssl rand -base64 48
JWT_SECRET=

# 토큰 만료 시간(ms). 생략하면 24시간.
# JWT_EXPIRATION_MS=86400000


# ---------------------------------------------
# [필수] MySQL
# ---------------------------------------------
DB_PASSWORD=
# 도커로 실행할 때는 아래 두 줄이 필요 없다 (docker-compose.yml 에서 주입).
# 로컬에서 백엔드만 따로 띄울 때만 사용한다.
# DB_URL=jdbc:mysql://localhost:3306/artifact_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
# DB_USERNAME=root


# ---------------------------------------------
# [선택] 초기 관리자 계정
# ---------------------------------------------
# 둘 다 채우면 서버 기동 시 ADMIN 계정을 1회 생성한다.
# 비워두면 만들지 않는다 — 이 경우 화면에서 회원가입해 사용하면 된다.
# (회원가입으로는 DOCTOR/NURSE/STAFF 만 만들 수 있고 ADMIN 은 만들 수 없다)
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=


# ---------------------------------------------
# [선택] 이미지 저장소
# ---------------------------------------------
# local = 서버 디스크에 저장 (AWS 없이 개발 가능)
# s3    = AWS S3 사용
IMAGE_STORAGE_TYPE=local
IMAGE_LOCAL_UPLOAD_DIR=/tmp/artifact-images

# IMAGE_STORAGE_TYPE=s3 일 때만 필요
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1


# ---------------------------------------------
# [선택] AI 추론 서버
# ---------------------------------------------
# FASTAPI_URL=http://localhost:8000
# MIN_TOP1_CONFIDENCE=0.45


# ---------------------------------------------
# [선택] Gemini (처방 코멘트)
# ---------------------------------------------
# 비워두면 코멘트 API 가 "키가 설정되지 않았습니다"를 반환한다. 앱은 정상 동작.
GEMINI_API_KEY=
