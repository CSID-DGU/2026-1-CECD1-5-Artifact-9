# print-agent 설정. 이 파일을 .env 로 복사해서 쓴다.
# (값이 비어 있으면 config.py 의 기본값이 적용된다)

# ── 키오스크 ────────────────────────────────────────────────────────────────
# 접수증 QR 에 들어갈 주소의 앞부분. QR 내용은 KIOSK_BASE_URL + /kiosk/{token}.
KIOSK_BASE_URL=https://artifact-prod.duckdns.org

# ── QR ─────────────────────────────────────────────────────────────────────
# ★ 아직 아이패드 실측 전 잠정값. /debug/qr-calibration 으로 확정할 것.
QR_SIZE=8
QR_NATIVE=true
# 오류정정 레벨 L=0 M=1 Q=2 H=3. 지금까지 검증된 값은 0(L).
QR_EC_LEVEL=0

# ── 도장 ───────────────────────────────────────────────────────────────────
# 비워두면 ../frontend/public/hospital-seal.svg 를 쓴다.
#SEAL_SVG_PATH=
# 200px ≈ 25mm. 200/160 둘 다 판독 가능 확인.
SEAL_SIZE_PX=200

# ── 프린터 (SEWOO SLK-TS100 실측값) ─────────────────────────────────────────
PRINTER_VID=0x1fc9
PRINTER_PID=0x2016
PRINTER_TIMEOUT=0
LINE_WIDTH=42

# ── 백엔드 폴링 (poller.py) ─────────────────────────────────────────────────
# ★ 실제 운영에서 채워야 하는 값은 사실상 여기 세 줄뿐이다.
#
# 이 맥북이 배포본에 접속해 인쇄 작업을 가져온다(나가는 연결만 쓴다). 그래서
# 공유기·방화벽·고정주소와 무관하고, EC2 에는 넣을 설정이 없다.
# 자세한 배경은 README "배포본과 이어붙이기" 참고.
BACKEND_URL=https://artifact-prod.duckdns.org

# 프린터 전용 직원 계정(STAFF). 사람이 쓰는 계정과 섞지 않는다 — 비밀번호를 이
# 파일에 적어 두게 되고, 감사 로그에서 누가 무엇을 했는지 구분되지 않는다.
BACKEND_LOGIN_ID=
BACKEND_PASSWORD=

# 폴링을 끄는 스위치. 프린터 레이아웃만 손볼 때처럼 백엔드 없이 띄울 때 쓴다.
#POLL_ENABLED=true
# 롱 폴링 한 번을 기다리는 시간. 백엔드의 print.queue.poll-wait-seconds(기본 25초)
# 보다 넉넉해야 한다 — 더 짧으면 서버가 막 건네려던 작업을 못 받고 끊는다.
#POLL_TIMEOUT_SECONDS=40

# ── 인증 ───────────────────────────────────────────────────────────────────
# 이 에이전트가 여는 HTTP 엔드포인트(/print/*, /health)를 지키는 토큰.
# 폴링 구조에서는 백엔드가 이쪽을 부르지 않으므로 평소에는 비워 둬도 된다.
#
# 다만 AGENT_HOST 기본값이 0.0.0.0 이라 같은 와이파이의 다른 기기는 닿을 수 있다.
# 공용 와이파이를 쓰는 자리라면 AGENT_HOST=127.0.0.1 로 묶거나 이 토큰을 채운다.
#   토큰 생성:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=

# ── 서버 ───────────────────────────────────────────────────────────────────
AGENT_HOST=0.0.0.0
# 5000=AirPlay, 5001=다른 프로젝트 컨테이너가 점유. 바꾸면 백엔드의
# PRINT_AGENT_URL 도 같이 바꿔야 한다.
AGENT_PORT=5051

# ── 문서 문구/링크 ──────────────────────────────────────────────────────────
HOSPITAL_NAME=아티팩트 피부과의원
#PORTAL_BASE_URL=            # 비우면 KIOSK_BASE_URL 을 그대로 쓴다
# 진료요약서 / 발급확인증 QR 이 가리킬 주소.
# {base}=PORTAL_BASE_URL, {token}=백엔드가 발급한 문서별 열람 토큰.
# 로그인 없이 그 문서 한 건만 보는 공개 경로라 /main/* 이 아니다.
#VISIT_SUMMARY_URL_TEMPLATE={base}/d/v/{token}
#CERTIFICATE_VERIFY_URL_TEMPLATE={base}/d/c/{token}

# ── 개발용 ─────────────────────────────────────────────────────────────────
# true 면 실제 USB 로 보내지 않고 바이트만 만들어 본다(프린터 없이 테스트).
DRY_RUN=false
