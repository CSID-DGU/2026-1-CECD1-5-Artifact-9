# print-agent 설정. 이 파일을 .env 로 복사해서 쓴다.
# (값이 비어 있으면 config.py 의 기본값이 적용된다)

# ── 키오스크 ────────────────────────────────────────────────────────────────
# 접수증 QR 에 들어갈 주소의 앞부분. QR 내용은 KIOSK_BASE_URL + /kiosk/{token}.
KIOSK_BASE_URL=https://artifact-prod.duckdns.org

# ── QR ─────────────────────────────────────────────────────────────────────
# ★ 아직 아이패드 실측 전 잠정값. /debug/qr-calibration 으로 확정할 것.
QR_SIZE=8
QR_NATIVE=true
# 오류정정 레벨 L=0 M=1 Q=2 H=3. 지금까지 검증된 값은 0(L).
QR_EC_LEVEL=0

# ── 도장 ───────────────────────────────────────────────────────────────────
# 비워두면 ../frontend/public/hospital-seal.svg 를 쓴다.
#SEAL_SVG_PATH=
# 200px ≈ 25mm. 200/160 둘 다 판독 가능 확인.
SEAL_SIZE_PX=200

# ── 프린터 (SEWOO SLK-TS100 실측값) ─────────────────────────────────────────
PRINTER_VID=0x1fc9
PRINTER_PID=0x2016
PRINTER_TIMEOUT=0
LINE_WIDTH=42

# ── 서버 ───────────────────────────────────────────────────────────────────
AGENT_HOST=0.0.0.0
# 5000=AirPlay, 5001=다른 프로젝트 컨테이너가 점유. 바꾸면 백엔드의
# PRINT_AGENT_URL 도 같이 바꿔야 한다.
AGENT_PORT=5051

# ── 문서 문구/링크 ──────────────────────────────────────────────────────────
HOSPITAL_NAME=아티팩트 피부과의원
#PORTAL_BASE_URL=            # 비우면 KIOSK_BASE_URL 을 그대로 쓴다
#VISIT_SUMMARY_URL_TEMPLATE={base}/main/lookup?visitId={visitId}
#CERTIFICATE_VERIFY_URL_TEMPLATE={base}/main/certificate?serialNo={serialNo}

# ── 개발용 ─────────────────────────────────────────────────────────────────
# true 면 실제 USB 로 보내지 않고 바이트만 만들어 본다(프린터 없이 테스트).
DRY_RUN=false
