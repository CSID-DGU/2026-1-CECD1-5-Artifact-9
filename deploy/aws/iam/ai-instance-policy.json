{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullAiImageFromEcr",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:ap-northeast-2:ACCOUNT_ID:repository/artifact-ai"
    },
    {
      "Sid": "EcrLoginToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ReadInternalSecret",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID:parameter/artifact/INTERNAL_API_SECRET"
    }
  ]
}
