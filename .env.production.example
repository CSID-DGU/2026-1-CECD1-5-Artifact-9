# =============================================
# Team Artifact — EC2 운영 서버용 환경변수 템플릿
# =============================================
# 이 파일은 "무엇을 채워야 하는지"만 알려주는 견본이다. 실제 값은 절대 여기 적지 않는다.
#
# EC2 에서 쓰는 법:
#   cp .env.production.example .env
#   nano .env          ← 아래 값을 채운다
#   chmod 600 .env     ← 다른 사용자가 못 읽게 한다
#
# 파일 이름이 `.env` 여야 한다. docker compose 는 `.env` 만 자동으로 읽는다.
#
# ---------------------------------------------
# 로컬 .env 를 그대로 복사해 오지 말 것
# ---------------------------------------------
# 로컬 값은 팀원 여러 명의 노트북과 채팅방을 거쳤다고 봐야 한다. 운영 서버의 값은
# EC2 안에서 새로 만들어 그 서버 밖으로 나가지 않게 한다.
# 아래 세 값은 **EC2 에 접속한 상태에서** 만들어 붙여 넣는다.
# =============================================


# ---------------------------------------------
# [필수] JWT 서명키
# ---------------------------------------------
# 이 값을 아는 사람은 누구든 로그인 없이 "나는 의사다" 라고 적힌 토큰을 만들 수 있다.
# 비어 있으면 백엔드가 기동되지 않는다.
#
# 생성:  openssl rand -base64 48
JWT_SECRET=

# 토큰 만료 시간(ms). 생략하면 24시간.
# 운영에서는 8시간(28800000) 정도로 줄이는 것을 권장한다 — 근무 교대 주기에 맞춘다.
JWT_EXPIRATION_MS=28800000


# ---------------------------------------------
# [필수] 백엔드 ↔ FastAPI 내부 호출 시크릿
# ---------------------------------------------
# 생성:  openssl rand -base64 32
INTERNAL_API_SECRET=


# ---------------------------------------------
# [필수] MySQL root 비밀번호
# ---------------------------------------------
# 주의: 이 값은 **DB 를 처음 만들 때 한 번만** 적용된다. 나중에 .env 만 바꿔도
# 이미 만들어진 데이터 볼륨의 비밀번호는 바뀌지 않는다. 처음부터 제대로 정할 것.
#
# 생성:  openssl rand -base64 24
DB_PASSWORD=


# ---------------------------------------------
# [권장] 초기 관리자 계정
# ---------------------------------------------
# 서버가 처음 뜰 때 ADMIN 계정을 1회 만든다. 회원가입 화면으로는 ADMIN 을 만들 수 없으므로
# 최초 1명은 여기서 만든다. 계정을 만든 뒤에는 이 두 줄을 비우고 재기동하는 편이 안전하다.
#
# 비밀번호는 길게. 로컬에서 쓰던 짧은 값을 그대로 가져오지 말 것.
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=


# ---------------------------------------------
# [선택] 이미지 저장소
# ---------------------------------------------
# local = EC2 디스크에 저장. 도커 볼륨(artifact-images)에 쌓이므로 컨테이너를 지워도 남는다.
#         단 EC2 인스턴스를 통째로 삭제하면 함께 사라진다. 시연·초기 운영에는 충분하다.
# s3    = AWS S3 사용. 아래 4개 값을 채워야 한다.
IMAGE_STORAGE_TYPE=local
IMAGE_LOCAL_UPLOAD_DIR=/app/artifact-images

# IMAGE_STORAGE_TYPE=s3 일 때만 필요.
# EC2 에서는 두 키를 **비워 두고** 인스턴스에 IAM 역할을 붙이는 쪽을 권한다 — 키가 비어 있으면 백엔드가
# 인스턴스 역할로 S3 에 접근한다(AwsConfig, 권한 예시 deploy/aws/iam/backend-instance-s3-policy.json).
# 키를 쓴다면 S3 해당 버킷에만 권한을 준 전용 IAM 사용자를 새로 만들어 쓸 것.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2


# ---------------------------------------------
# [선택] LLM (처방 코멘트·증명서 초안·키오스크 소견)
# ---------------------------------------------
# 호출 순서: Gemini 1차 모델 → Gemini 대체 모델 → Claude. 처음 성공한 응답을 쓴다.
# 키가 하나도 없으면 이 기능들만 "키가 설정되지 않았습니다"를 반환하고 나머지는 정상 동작한다.
GEMINI_API_KEY=
# Gemini 가 과부하로 모두 실패할 때 대신 답할 Claude 키. 다른 회사라 Google 쪽 장애에 함께 묶이지 않는다.
# 비워두면 Claude 단계만 건너뛴다. 모델은 ANTHROPIC_MODEL 로 바꿀 수 있다(기본 claude-haiku-5-5).
# 주의: 키를 넣으면 식별정보를 지운 프롬프트(상병·접수 메모·처방 정보)가 Anthropic(미국)에도 전송된다.
# 운영에 켜기 전에 개인정보 처리방침·국외 이전 고지를 함께 고친다.
ANTHROPIC_API_KEY=


# ---------------------------------------------
# [선택] 성능·동작 조정
# ---------------------------------------------
# DB 커넥션 풀. EC2 t3.small 정도면 기본 10으로 충분하다.
# DB_POOL_SIZE=10

# AI 추론 대기 한도(초). CPU 추론이라 넉넉히 둔다.
# FASTAPI_TIMEOUT_SECONDS=30

# QR 없이 "다음 대기 환자"로 자동 진입하는 폴백.
# 토큰 없이 접근 대상을 알려주는 유일한 경로라 운영에서는 반드시 false.
KIOSK_AUTO_PENDING=false

# Telegram team demo notifications; disabled until configured.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUBLIC_BASE_URL=


# ---------------------------------------------
# [ELB 구성일 때 필수] 화면은 Vercel, AI 는 AI 오토스케일링 그룹 (DEPLOY_TARGET=elb)
# ---------------------------------------------
# 한 서버 구성(화면·AI 를 이 서버에서 같이 띄움)에서는 비워 둔다. 절차는 docs/aws-elb-asg-guide.md.
# 세 값 중 하나라도 비어 있으면 ELB 구성의 백엔드가 기동하지 않는다(docker-compose.elb.yml).
# ⚠️ 한 서버 구성이 아직 돌 때 미리 넣는다면 CORS_ALLOWED_ORIGINS·PRINT_KIOSK_ALLOWED_BASE_URLS 에 지금 주소
#    (https://artifact-prod.duckdns.org)도 쉼표로 같이 적는다. 새 주소만 적으면 그 순간 지금 사이트의 로그인이 막힌다.
#
# 내부 ALB 주소(포트 80, 끝에 / 없이). 백엔드는 여기로 AI 추론을 보낸다.
# FASTAPI_URL=http://internal-artifact-ai-alb-123456789.ap-northeast-2.elb.amazonaws.com
#
# Vercel 화면 주소. 화면과 API 의 출처가 달라 브라우저가 CORS 를 확인한다 — 없으면 로그인부터 막힌다.
# CORS_ALLOWED_ORIGINS=https://artifact.example.com
#
# 접수증 QR 에 찍힐 키오스크 주소의 허용 목록 = 화면 주소.
# PRINT_KIOSK_ALLOWED_BASE_URLS=https://artifact.example.com
#
# 텔레그램 알림을 켜 두었다면 이것도 화면 주소로 바꾼다(위 TELEGRAM_PUBLIC_BASE_URL).
