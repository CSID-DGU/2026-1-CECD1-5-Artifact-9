# =============================================
# Team Artifact — EC2 운영 서버용 환경변수 템플릿
# =============================================
# 이 파일은 "무엇을 채워야 하는지"만 알려주는 견본이다. 실제 값은 절대 여기 적지 않는다.
#
# EC2 에서 쓰는 법:
#   cp .env.production.example .env
#   nano .env          ← 아래 값을 채운다
#   chmod 600 .env     ← 다른 사용자가 못 읽게 한다
#
# 파일 이름이 `.env` 여야 한다. docker compose 는 `.env` 만 자동으로 읽는다.
#
# ---------------------------------------------
# 로컬 .env 를 그대로 복사해 오지 말 것
# ---------------------------------------------
# 로컬 값은 팀원 여러 명의 노트북과 채팅방을 거쳤다고 봐야 한다. 운영 서버의 값은
# EC2 안에서 새로 만들어 그 서버 밖으로 나가지 않게 한다.
# 아래 세 값은 **EC2 에 접속한 상태에서** 만들어 붙여 넣는다.
# =============================================


# ---------------------------------------------
# [필수] JWT 서명키
# ---------------------------------------------
# 이 값을 아는 사람은 누구든 로그인 없이 "나는 의사다" 라고 적힌 토큰을 만들 수 있다.
# 비어 있으면 백엔드가 기동되지 않는다.
#
# 생성:  openssl rand -base64 48
JWT_SECRET=

# 토큰 만료 시간(ms). 생략하면 24시간.
# 운영에서는 8시간(28800000) 정도로 줄이는 것을 권장한다 — 근무 교대 주기에 맞춘다.
JWT_EXPIRATION_MS=28800000


# ---------------------------------------------
# [필수] 백엔드 ↔ FastAPI 내부 호출 시크릿
# ---------------------------------------------
# 생성:  openssl rand -base64 32
INTERNAL_API_SECRET=


# ---------------------------------------------
# [필수] MySQL root 비밀번호
# ---------------------------------------------
# 주의: 이 값은 **DB 를 처음 만들 때 한 번만** 적용된다. 나중에 .env 만 바꿔도
# 이미 만들어진 데이터 볼륨의 비밀번호는 바뀌지 않는다. 처음부터 제대로 정할 것.
#
# 생성:  openssl rand -base64 24
DB_PASSWORD=


# ---------------------------------------------
# [권장] 초기 관리자 계정
# ---------------------------------------------
# 서버가 처음 뜰 때 ADMIN 계정을 1회 만든다. 회원가입 화면으로는 ADMIN 을 만들 수 없으므로
# 최초 1명은 여기서 만든다. 계정을 만든 뒤에는 이 두 줄을 비우고 재기동하는 편이 안전하다.
#
# 비밀번호는 길게. 로컬에서 쓰던 짧은 값을 그대로 가져오지 말 것.
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=


# ---------------------------------------------
# [선택] 이미지 저장소
# ---------------------------------------------
# local = EC2 디스크에 저장. 도커 볼륨(artifact-images)에 쌓이므로 컨테이너를 지워도 남는다.
#         단 EC2 인스턴스를 통째로 삭제하면 함께 사라진다. 시연·초기 운영에는 충분하다.
# s3    = AWS S3 사용. 아래 4개 값을 채워야 한다.
IMAGE_STORAGE_TYPE=local
IMAGE_LOCAL_UPLOAD_DIR=/app/artifact-images

# IMAGE_STORAGE_TYPE=s3 일 때만 필요.
# EC2 에서는 액세스 키 대신 **IAM 역할**을 붙이는 쪽이 안전하지만, 지금 구조는 키를 직접 읽는다.
# 키를 쓴다면 S3 해당 버킷에만 권한을 준 전용 IAM 사용자를 새로 만들어 쓸 것.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2


# ---------------------------------------------
# [선택] Gemini (처방 코멘트)
# ---------------------------------------------
# 비워두면 코멘트 기능만 "키가 설정되지 않았습니다"를 반환하고 나머지는 정상 동작한다.
GEMINI_API_KEY=


# ---------------------------------------------
# [선택] 성능·동작 조정
# ---------------------------------------------
# DB 커넥션 풀. EC2 t3.small 정도면 기본 10으로 충분하다.
# DB_POOL_SIZE=10

# AI 추론 대기 한도(초). CPU 추론이라 넉넉히 둔다.
# FASTAPI_TIMEOUT_SECONDS=30

# QR 없이 "다음 대기 환자"로 자동 진입하는 폴백.
# 토큰 없이 접근 대상을 알려주는 유일한 경로라 운영에서는 반드시 false.
KIOSK_AUTO_PENDING=false
